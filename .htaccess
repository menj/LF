# Langgam Fikir: keep development files off the web.
#
# Until the theme's clean-up (inc/dev-files.php) has removed them, refuse the hidden files and
# folders (.git, .gitignore ...; .well-known stays reachable) and the tools, tests, bin, docs and server
# folders at the top of the theme. The patterns need the theme to sit in a "themes" folder, as
# WordPress themes do. Needs Apache or LiteSpeed; nginx ignores .htaccess, so deny these there.

<IfModule mod_alias.c>
RedirectMatch 403 (?i)^/(?:[^/]+/)*themes/[^/]+/(?:[^/]+/)*\.(?!well-known(?:/|$)|htaccess$|user\.ini$)
RedirectMatch 403 (?i)^/(?:[^/]+/)*themes/[^/]+/(?:tools|tests|bin|docs|server)(?:/|$)
</IfModule>

# Without mod_alias, the same with mod_rewrite (matched from the theme folder).
<IfModule !mod_alias.c>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (?i)(^|/)\.(?!well-known(/|$)|htaccess$|user\.ini$) - [F,L]
RewriteRule (?i)^(tools|tests|bin|docs|server)(/|$) - [F,L]
</IfModule>
</IfModule>
